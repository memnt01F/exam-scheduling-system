# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/your_database?retryWrites=true&w=majority

# Port the Express server listens on (default: 5001)
PORT=5001

# URL of the Python scheduler service (FastAPI).
# Local dev: http://localhost:8000
# Production: set to the deployed Render service URL (e.g. https://schudeler-api.onrender.com)
SCHEDULER_URL=http://localhost:8000
